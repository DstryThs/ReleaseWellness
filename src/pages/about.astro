---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { BOOKING_URL, CREDENTIALS } from '../data/site';
import { getPage } from '../lib/content';
import { resolveImage } from '../lib/images';
import { paragraphs } from '../lib/md';

const about = await getPage('about');
const portrait = resolveImage(about.portrait);
---

<Base title={about.seo.title} description={about.seo.description}>

  <article class="about container-narrow section">
    <header class="about-header">
      <p class="eyebrow">About</p>
      <h1>{about.heading}</h1>
    </header>

    <figure class="portrait">
      <Image
        src={portrait}
        alt={about.portrait_alt}
        class="portrait-img"
        widths={[360, 540, 720]}
        width={720}
        sizes="(min-width: 640px) 360px, 80vw"
        format="webp"
        loading="eager"
      />
    </figure>

    <section class="prose">
      <p class="lede">{about.lede}</p>
    </section>

    {about.sections.map((section) => (
      <section class="prose">
        <h2>{section.heading}</h2>
        {paragraphs(section.body).map((p) => <p set:html={p} />)}
      </section>
    ))}

    <section class="prose closing">
      {paragraphs(about.closing).map((p) => <p set:html={p} />)}
    </section>

    <aside class="credentials" aria-labelledby="credentials-heading">
      <h2 id="credentials-heading" class="eyebrow">Credentials &amp; supervision</h2>
      <p>
        {CREDENTIALS.practitioner}, {CREDENTIALS.title},
        registered with the California Board of Behavioral Sciences,
        supervised by {CREDENTIALS.supervisor}, {CREDENTIALS.supervisorCredential} #{CREDENTIALS.supervisorNumber}.
      </p>
    </aside>

    <div class="cta-row">
      <a
        href={BOOKING_URL}
        class="btn btn-primary"
        data-cta="book-consult"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a Consult
      </a>
    </div>
  </article>

</Base>

<style>
  .about-header { margin-bottom: var(--space-lg); }
  .about-header .eyebrow { margin-bottom: var(--space-2xs); }

  .portrait {
    margin: 0 auto var(--space-lg);
    max-width: 360px;
  }
  .portrait-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .prose { margin-bottom: var(--space-lg); }
  .prose h2 {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-2xs);
  }

  .prose.closing p {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: var(--lh-snug);
    color: var(--color-sage-deep);
  }

  .credentials {
    margin-block: var(--space-xl);
    padding: var(--space-md);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: var(--color-sage-light);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .credentials .eyebrow { margin-bottom: var(--space-2xs); }

  .cta-row { margin-top: var(--space-lg); }
</style>
