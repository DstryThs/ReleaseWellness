---
import Base from '../layouts/Base.astro';
import BookingDisclosure from '../components/BookingDisclosure.astro';
import { BOOKING_URL } from '../data/site';
import { getPage } from '../lib/content';
import { paragraphs } from '../lib/md';

const fees = await getPage('fees');
---

<Base title={fees.seo.title} description={fees.seo.description}>

  <article class="container-narrow section fees">
    <header>
      <p class="eyebrow">Fees &amp; Insurance</p>
      <h1>{fees.heading}</h1>
      <p class="lede muted intro">{fees.intro}</p>
    </header>

    <section class="prose">
      <h2>Session fees</h2>
      <ul class="fee-list">
        {fees.fee_list.map((fee) => (
          <li>
            <span class="fee-label">{fee.label}</span>
            <span class="fee-amount">{fee.amount}</span>
          </li>
        ))}
      </ul>
      {paragraphs(fees.fee_note).map((p) => <p set:html={p} />)}
    </section>

    {fees.policies.map((policy) => (
      <section class="prose">
        <h2>{policy.heading}</h2>
        {paragraphs(policy.body).map((p) => <p set:html={p} />)}
      </section>
    ))}

    <section class="prose">
      <h2>Good Faith Estimate</h2>
      <p>
        Under the federal No Surprises Act, you have the right to a Good Faith
        Estimate of expected charges before beginning care. <a href="/good-faith-estimate">Learn more about your right to a Good Faith Estimate &rarr;</a>
      </p>
    </section>

    <div class="cta-card">
      <h2>{fees.cta.heading}</h2>
      {paragraphs(fees.cta.body).map((p) => <p class="muted" set:html={p} />)}
      <a
        href={BOOKING_URL}
        class="btn btn-primary"
        data-cta="book-consult"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a Consult
      </a>
      <BookingDisclosure />
    </div>
  </article>

</Base>

<style>
  .fees header { margin-bottom: var(--space-lg); }
  .fees header .eyebrow { margin-bottom: var(--space-2xs); }
  .fees .intro { margin-top: var(--space-md); }

  .prose { margin-bottom: var(--space-lg); }
  .prose h2 {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-2xs);
  }

  .fee-list {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 var(--space-md);
    border-top: 1px solid var(--color-rule);
  }
  .fee-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-rule);
  }
  .fee-label { font-family: var(--font-serif); font-size: 1.125rem; }
  .fee-amount { font-variant-numeric: tabular-nums; color: var(--color-sage-deep); }

  .cta-card {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--color-sage-light);
    border-radius: var(--radius-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
  .cta-card h2 { font-size: var(--fs-h2); }
</style>
