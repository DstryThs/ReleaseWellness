---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Get in touch — phone, email, or book a consult directly through SimplePractice.">

  <section class="container-narrow section">
    <header>
      <p class="eyebrow">Contact</p>
      <h1>Reach out.</h1>
      <p class="lede muted intro">
        The fastest way to start is to book a consult. You're also welcome to
        send a short note — no need to explain everything up front.
      </p>
    </header>

    {/*
      No contact form by design — phone, email, and SimplePractice booking
      cover it without risking PHI in form submissions. Per build-plan.md
      decision #4 (2026-05-01).
    */}
    <ul class="contact-list">
      <li>
        <span class="eyebrow">Book a consult</span>
        <a href="#" class="btn btn-primary" data-cta="book-consult">
          Schedule through SimplePractice
        </a>
        <p class="muted small">[SimplePractice booking URL TBD]</p>
      </li>
      <li>
        <span class="eyebrow">Email</span>
        <a href="mailto:[email TBD]" class="contact-link">[email TBD]</a>
      </li>
      <li>
        <span class="eyebrow">Phone</span>
        <a href="tel:+1[phone TBD]" class="contact-link">[phone TBD]</a>
      </li>
    </ul>

    <p class="muted note">
      For anything urgent or in crisis, please call or text 988 (Suicide and
      Crisis Lifeline) or go to your nearest emergency room.
    </p>
  </section>

</Base>

<style>
  .intro { margin-top: var(--space-md); }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-start;
  }

  .contact-list .eyebrow { margin-bottom: var(--space-3xs); }

  .contact-link {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    color: var(--color-charcoal);
    text-decoration: none;
  }
  .contact-link:hover { color: var(--color-sage-deep); }

  .small { font-size: 0.8125rem; }

  .note {
    margin-top: var(--space-xl);
    padding: var(--space-md);
    border-inline-start: 3px solid var(--color-sage);
    background: var(--color-sage-light);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
