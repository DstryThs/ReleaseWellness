---
import Base from '../layouts/Base.astro';
import BookingDisclosure from '../components/BookingDisclosure.astro';
import { BOOKING_URL } from '../data/site';
import { getContact, getPage, telHref } from '../lib/content';

const page = await getPage('contact');
const contact = await getContact();
---

<Base title={page.seo.title} description={page.seo.description}>

  <section class="container-narrow section">
    <header>
      <p class="eyebrow">Contact</p>
      <h1>{page.heading}</h1>
      <p class="lede muted intro">{page.intro}</p>
    </header>

    <ul class="contact-list">
      <li>
        <span class="eyebrow">Book a consult</span>
        <a
          href={BOOKING_URL}
          class="btn btn-primary"
          data-cta="book-consult"
          target="_blank"
          rel="noopener noreferrer"
        >
          Schedule through SimplePractice
        </a>
        <BookingDisclosure />
      </li>
      <li>
        <span class="eyebrow">Email</span>
        <a href={`mailto:${contact.email}`} class="contact-link">
          {contact.email}
        </a>
      </li>
      <li>
        <span class="eyebrow">Phone</span>
        <a href={telHref(contact.phone)} class="contact-link">
          {contact.phone}
        </a>
      </li>
      <li>
        <span class="eyebrow">Office</span>
        <address class="contact-address">
          {contact.address_line1}
          <br />
          {contact.address_line2}
        </address>
      </li>
    </ul>

    <p class="muted note">
      For anything urgent or in crisis, please call or text 911 or 988
      (Suicide and Crisis Lifeline) or go to your nearest emergency room.
    </p>

    <p class="muted small confidentiality">
      Email and standard phone calls are not secure or confidential channels.
      Please don't share sensitive personal or clinical information through
      them. Once you're an established client, secure communication is
      available through the SimplePractice client portal.
    </p>
  </section>

</Base>

<style>
  .intro { margin-top: var(--space-md); }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-start;
  }

  .contact-list .eyebrow { margin-bottom: var(--space-3xs); }

  .contact-link {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    color: var(--color-charcoal);
    text-decoration: none;
  }
  .contact-link:hover { color: var(--color-sage-deep); }

  .contact-address {
    font-style: normal;
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: 1.4;
    color: var(--color-charcoal);
  }

  .small { font-size: 0.8125rem; }

  .note {
    margin-top: var(--space-xl);
    padding: var(--space-md);
    border-inline-start: 3px solid var(--color-sage);
    background: var(--color-sage-light);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .confidentiality {
    margin-top: var(--space-md);
    line-height: 1.55;
  }
</style>
