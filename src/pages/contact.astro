---
import Base from '../layouts/Base.astro';
import { BOOKING_URL } from '../data/site';
---

<Base
  title="Contact"
  description="Get in touch with Release Wellness — phone, email, or book a consult through SimplePractice."
>

  <section class="container-narrow section">
    <header>
      <p class="eyebrow">Contact</p>
      <h1>Reach out.</h1>
      <p class="lede muted intro">
        The fastest way to start is to book a consult. You're also welcome to
        send a short note, no need to explain everything up front.
      </p>
    </header>

    <ul class="contact-list">
      <li>
        <span class="eyebrow">Book a consult</span>
        <a
          href={BOOKING_URL}
          class="btn btn-primary"
          data-cta="book-consult"
          target="_blank"
          rel="noopener noreferrer"
        >
          Schedule through SimplePractice
        </a>
      </li>
      <li>
        <span class="eyebrow">Email</span>
        <a href="mailto:tanya@releasewellnessca.com" class="contact-link">
          tanya@releasewellnessca.com
        </a>
      </li>
      <li>
        <span class="eyebrow">Phone</span>
        <a href="tel:+19496873899" class="contact-link">
          (949) 687-3899
        </a>
      </li>
      <li>
        <span class="eyebrow">Office</span>
        <address class="contact-address">
          324 Avenida de La Estella, Suite B
          <br />
          San Clemente, CA 92672
        </address>
      </li>
    </ul>

    <p class="muted note">
      For anything urgent or in crisis, please call or text 911 or 988
      (Suicide and Crisis Lifeline) or go to your nearest emergency room.
    </p>

    <p class="muted small confidentiality">
      Email and standard phone calls are not secure or confidential channels.
      Please don't share sensitive personal or clinical information through
      them. Once you're an established client, secure communication is
      available through the SimplePractice client portal.
    </p>
  </section>

</Base>

<style>
  .intro { margin-top: var(--space-md); }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: var(--space-xl) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-start;
  }

  .contact-list .eyebrow { margin-bottom: var(--space-3xs); }

  .contact-link {
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    color: var(--color-charcoal);
    text-decoration: none;
  }
  .contact-link:hover { color: var(--color-sage-deep); }

  .contact-address {
    font-style: normal;
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: 1.4;
    color: var(--color-charcoal);
  }

  .small { font-size: 0.8125rem; }

  .note {
    margin-top: var(--space-xl);
    padding: var(--space-md);
    border-inline-start: 3px solid var(--color-sage);
    background: var(--color-sage-light);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .confidentiality {
    margin-top: var(--space-md);
    line-height: 1.55;
  }
</style>
