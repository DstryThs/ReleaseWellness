---
import Base from '../layouts/Base.astro';

const services = [
  {
    title: 'EMDR',
    blurb: 'Trauma reprocessing at the nervous-system level — moving through what is stuck rather than only talking about it.',
  },
  {
    title: 'Somatic therapy',
    blurb: "Listening through the body — sensation, breath, and posture — alongside what we say out loud.",
  },
  {
    title: 'Nature-based therapy',
    blurb: 'Drawing on the natural world to help you settle, regulate, and reconnect.',
  },
  {
    title: 'Sound healing',
    blurb: 'Vibrational practices that support the nervous system and create space for what has been held alone.',
  },
  {
    title: 'Aromatherapy',
    blurb: 'Essential oils used as a sensory anchor — supporting grounding, regulation, and presence in the body.',
  },
];

const feelings = [
  'Overwhelmed or anxious',
  'Stuck in patterns',
  'Disconnected from yourself',
  'Carrying something heavy',
];
---

<Base
  title="Release Wellness"
  description="Healing that meets you in rhythm with nature. Trauma-informed therapy integrating EMDR, somatic, sound, aromatherapy, and nature-based approaches in San Clemente, California."
>

  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1>Healing that meets you in rhythm with nature.</h1>
        <div class="divider" aria-hidden="true">&#10047;</div>
        <p class="lede muted">
          Trauma-informed therapy integrating somatic healing, EMDR,
          sound-based practices, and nature-centered grounding.
        </p>
        <div class="hero-buttons">
          <a href="#" class="btn btn-primary" data-cta="book-consult">
            Book a Consult
          </a>
          <a href="/about" class="btn btn-ghost">Learn More</a>
        </div>
      </div>
      <div class="hero-image" aria-hidden="true">
        <div class="hero-image-placeholder">
          <span>[Hero image / ambient video: misty forest canopy]</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section approach" aria-labelledby="approach-heading">
    <div class="container approach-inner">
      <div class="approach-image" aria-hidden="true">
        <div class="image-placeholder">
          <span>[Image: backlit leaves on a branch]</span>
        </div>
      </div>
      <div class="approach-text">
        <p class="eyebrow">Welcome</p>
        <h2 id="approach-heading">Therapy moves at the pace of safety.</h2>
        <p>
          You don't have to force your way through healing alone or in spaces
          that feel clinical, rushed, or disconnected.
        </p>
        <p>
          This work honors the body, the nervous system, and the quiet
          intelligence that already exists within you.
        </p>
        <p>
          <a href="/about">Read more about my approach &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section services" aria-labelledby="services-heading">
    <div class="container services-inner">
      <p class="eyebrow center">Services</p>
      <h2 id="services-heading" class="center">Ways we might work together</h2>
      <ul class="services-grid">
        {services.map((service) => (
          <li class="service-card">
            <div class="service-icon" aria-hidden="true">&#10047;</div>
            <h3>{service.title}</h3>
            <p>{service.blurb}</p>
          </li>
        ))}
      </ul>
      <p class="services-cta center">
        <a href="/services">See all services &rarr;</a>
      </p>
    </div>
  </section>

  <section class="section empathy" aria-labelledby="empathy-heading">
    <div class="container empathy-inner">
      <p class="eyebrow center">You might be feeling</p>
      <h2 id="empathy-heading" class="visually-hidden">
        You might be feeling
      </h2>
      <ul class="feelings">
        {feelings.map((feeling) => (
          <li>
            <span class="feeling-icon" aria-hidden="true">&#10047;</span>
            <span>{feeling}</span>
          </li>
        ))}
      </ul>
      <p class="empathy-close center lede">
        Whatever you're carrying, you don't have to do this alone.
      </p>
    </div>
  </section>

  <section class="section about-preview" aria-labelledby="about-preview-heading">
    <div class="container about-preview-inner">
      <div class="about-preview-text">
        <p class="eyebrow">About</p>
        <h2 id="about-preview-heading">Clinical training, embodied healing.</h2>
        <p>
          I'm a therapist who integrates clinical training with embodied,
          experiential healing. My work blends trauma-informed care with
          nature, sound, and somatic awareness — helping you reconnect to
          yourself in ways that feel grounded, not forced.
        </p>
        <p>
          I believe healing happens in relationship, safety, and attunement —
          not urgency.
        </p>
        <p>
          <a href="/about">More about Tanya &rarr;</a>
        </p>
      </div>
      <div class="about-preview-image" aria-hidden="true">
        <div class="image-placeholder portrait">
          <span>[Practitioner portrait]</span>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-banner" aria-labelledby="cta-heading">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2 id="cta-heading">Ready to begin?</h2>
        <p class="muted">
          If something here resonates, you're welcome to reach out.
        </p>
      </div>
      <div class="cta-buttons">
        <a href="#" class="btn btn-primary" data-cta="book-consult">
          Schedule a Consultation
        </a>
        <a href="mailto:tanya@releasewellnessca.com" class="btn btn-ghost">
          Ask a Question First
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* Hero */
  .hero { padding-block: var(--space-xl) var(--space-2xl); }
  .hero-inner {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); }
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .hero-image-placeholder,
  .image-placeholder {
    aspect-ratio: 4 / 5;
    background: var(--color-sage-light);
    border: 1px dashed var(--color-rule);
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    text-align: center;
  }
  .image-placeholder.portrait { aspect-ratio: 4 / 5; }

  @media (min-width: 880px) {
    .hero-inner { grid-template-columns: 1fr 1fr; gap: var(--space-2xl); }
    .hero { padding-block: var(--space-2xl) var(--space-3xl); }
  }

  /* Approach */
  .approach-inner {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  .approach-text { display: flex; flex-direction: column; gap: var(--space-md); }
  @media (min-width: 880px) {
    .approach-inner { grid-template-columns: 1fr 1fr; gap: var(--space-2xl); }
    .approach-image { order: 2; }
  }

  /* Services */
  .services-inner { display: flex; flex-direction: column; gap: var(--space-md); }
  .center { text-align: center; }
  .services-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 0;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2xs);
    padding: var(--space-md);
  }
  .service-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--color-sage);
    display: grid;
    place-items: center;
    color: var(--color-sage);
    font-size: 1.5rem;
    margin-bottom: var(--space-2xs);
  }
  .service-card p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .services-cta { margin-top: var(--space-md); }

  /* Empathy beat */
  .empathy { background: var(--color-cream); }
  .empathy-inner { display: flex; flex-direction: column; gap: var(--space-md); }
  .feelings {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    text-align: center;
  }
  .feelings li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    font-size: 0.9375rem;
  }
  .feeling-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--color-sage);
    display: grid;
    place-items: center;
    color: var(--color-sage);
  }
  .empathy-close { max-width: 36rem; margin-inline: auto; }
  @media (min-width: 720px) {
    .feelings { grid-template-columns: repeat(4, 1fr); }
  }

  /* About preview */
  .about-preview-inner {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  .about-preview-text { display: flex; flex-direction: column; gap: var(--space-md); }
  @media (min-width: 880px) {
    .about-preview-inner { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-2xl); }
  }

  /* CTA banner */
  .cta-banner {
    background: var(--color-sage-light);
    padding-block: var(--space-xl);
  }
  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .cta-banner h2 { margin-bottom: var(--space-2xs); }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  @media (min-width: 880px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Visually hidden, still announced by screen readers */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
