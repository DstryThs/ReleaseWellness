---
import Base from '../layouts/Base.astro';
import BookingDisclosure from '../components/BookingDisclosure.astro';
import { BOOKING_URL } from '../data/site';
import { getPage } from '../lib/content';
import { paragraphs } from '../lib/md';

const services = await getPage('services');
---

<Base title={services.seo.title} description={services.seo.description}>

  <section class="container-narrow section">
    <header>
      <p class="eyebrow">Services</p>
      <h1>{services.heading}</h1>
      <p class="lede muted intro">{services.intro}</p>
    </header>
  </section>

  <section class="container-narrow section-tight" aria-labelledby="help-with-heading">
    <p class="eyebrow">What I help with</p>
    <h2 id="help-with-heading">{services.help_with.heading}</h2>
    <ul class="bullet-list">
      {services.help_with.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="container-narrow section-tight" aria-labelledby="feels-heading">
    <p class="eyebrow">What therapy isn't:</p>
    <h2 id="feels-heading">{services.therapy_is.heading}</h2>
    <p class="muted">What therapy is:</p>
    <ul class="bullet-list">
      {services.therapy_is.items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="container section-tight services-list" aria-labelledby="modalities-heading">
    <div class="container-narrow services-header">
      <p class="eyebrow">Modalities</p>
      <h2 id="modalities-heading">{services.modalities_heading}</h2>
    </div>
    <ul>
      {services.modalities.map((service) => (
        <li class="service">
          <div class="service-icon" aria-hidden="true">&#10047;</div>
          <div class="service-body">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-narrow section-tight">
    <div class="cta-card">
      <h2>{services.cta.heading}</h2>
      {paragraphs(services.cta.body).map((p) => <p class="muted" set:html={p} />)}
      <div class="cta-actions">
        <a
          href={BOOKING_URL}
          class="btn btn-primary"
          data-cta="book-consult"
          target="_blank"
          rel="noopener noreferrer"
        >
          Book a Consult
        </a>
        <a href="/fees" class="btn btn-ghost">See fees &amp; insurance</a>
      </div>
      <BookingDisclosure />
    </div>
  </section>

</Base>

<style>
  .intro { margin-top: var(--space-md); }

  .bullet-list {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
  }
  .bullet-list li {
    position: relative;
    padding-inline-start: 1.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .bullet-list li:last-child { border-bottom: 0; }
  .bullet-list li::before {
    content: '\2756';
    position: absolute;
    inset-inline-start: 0;
    color: var(--color-sage);
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  .services-header { margin-bottom: var(--space-md); }

  .services-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .service {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }

  .service:first-child { border-top: 0; padding-top: 0; }

  .service-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--color-sage);
    display: grid;
    place-items: center;
    color: var(--color-sage);
    font-size: 1.5rem;
    flex: none;
  }

  .service-body h3 {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-2xs);
  }

  .cta-card {
    padding: var(--space-lg);
    background: var(--color-sage-light);
    border-radius: var(--radius-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
  .cta-card h2 { font-size: var(--fs-h2); }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: center;
  }
</style>
