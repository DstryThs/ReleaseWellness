---
import { CREDENTIALS } from '../data/site';
import { getContact, telHref } from '../lib/content';

const year = new Date().getFullYear();
const contact = await getContact();
const social = [
  { label: 'Psychology Today profile', href: contact.psychology_today_url },
  { label: 'Instagram', href: contact.instagram_url },
  { label: 'Facebook', href: contact.facebook_url },
].filter((link) => link.href);
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img
        src="/release-wellness-mark.png"
        alt=""
        class="footer-mark"
        width="244"
        height="259"
      />
      <span class="footer-wordmark">Release Wellness</span>
    </div>

    <address class="footer-contact">
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={telHref(contact.phone)}>{contact.phone}</a>
      <span class="footer-address">
        {contact.address_line1}
        <br />
        {contact.address_line2}
      </span>
    </address>

    <nav class="footer-secondary" aria-label="Secondary">
      <ul>
        {social.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-disclosure">
      <p>
        {CREDENTIALS.practitioner}, {CREDENTIALS.title},
        registered with the California Board of Behavioral Sciences.
        Practicing under the supervision of {CREDENTIALS.supervisor}, {CREDENTIALS.supervisorCredential} #{CREDENTIALS.supervisorNumber}.
      </p>
    </div>

    <nav class="footer-legal" aria-label="Legal">
      <ul>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/good-faith-estimate">Good Faith Estimate</a></li>
        <li><a href="/fees">Fees &amp; Insurance</a></li>
      </ul>
    </nav>

    <p class="footer-copy muted">© {year} Release Wellness, LLC</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
    margin-top: var(--space-2xl);
    padding-block: var(--space-xl);
    background: var(--color-cream);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .footer-mark {
    width: auto;
    height: 44px;
    display: block;
  }
  .footer-wordmark {
    font-family: var(--font-serif);
    font-size: 1.125rem;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.9375rem;
    font-style: normal;
  }
  .footer-contact a { color: var(--color-charcoal); }
  .footer-contact a:hover { color: var(--color-sage-deep); }
  .footer-address {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .footer-secondary ul,
  .footer-legal ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    font-size: 0.875rem;
  }

  .footer-disclosure {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    padding-block: var(--space-sm);
    border-block: 1px solid var(--color-rule);
  }

  .footer-copy {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
    margin-top: 0;
  }

  @media (min-width: 720px) {
    .footer-inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-lg) var(--space-md);
      align-items: start;
    }
    .footer-brand { grid-column: 1; grid-row: 1; }
    .footer-contact { grid-column: 2; grid-row: 1; }
    .footer-secondary { grid-column: 3; grid-row: 1; justify-self: end; }
    .footer-secondary ul { justify-content: flex-end; }
    .footer-disclosure { grid-column: 1 / -1; }
    .footer-legal { grid-column: 1 / -1; }
    .footer-legal ul { justify-content: flex-start; }
    .footer-copy { grid-column: 1 / -1; text-align: right; }
  }
</style>
